#!/usr/bin/env bash
# Tests ordered_apply (docs/adr/0003): the master records a write request's
# btree operations in a plan and applies the plans one transaction at a time.
# Turning it on must not change what clients see.  Requests a plan cannot hold
# (foreign keys, schema changes, triggers) must run as before.
bash -n "$0" || exit 1

set -e

dbname=$1
[ -z "$dbname" ] && { echo "usage: runit <dbname>" >&2; exit 1; }

sql() { cdb2sql --tabs ${CDB2_OPTIONS} $dbname default "$1"; }

master=$(sql "select host from comdb2_cluster where is_master='Y'")
[ -z "$master" ] && { echo "could not find the master" >&2; exit 1; }
master_sql() { cdb2sql --tabs ${CDB2_OPTIONS} $dbname --host $master "$1"; }
counter() { master_sql "select cast(value as int) from comdb2_metrics where name='ordered_apply_$1'"; }
set_tunable() {
    cdb2sql ${CDB2_OPTIONS} $dbname --host $master "exec procedure sys.cmd.send('$1 $2')" >/dev/null
}
fail() { echo "FAILED: $1" >&2; exit 1; }

sql "create table t(a bigint, b bigint, c bigint, pad varchar(64))" >/dev/null
sql "create index ta on t(a)" >/dev/null
sql "create index tb on t(b)" >/dev/null
sql "create table u(a int unique, b int)" >/dev/null
sql "create table p(a int primary key)" >/dev/null
sql "create table ch(a int, constraint fk foreign key(a) references p(a))" >/dev/null
sql "create table bl(a int, b blob)" >/dev/null

################################################################
# 1. Off by default: nothing is planned.
################################################################
[ "$(master_sql "select value from comdb2_tunables where name='ordered_apply'")" = "OFF" ] \
    || fail "ordered_apply should default to OFF"
sql "insert into t values(1, 1, 1, 'off')" >/dev/null
[ "$(counter txns)" = "0" ] || fail "nothing should be planned while the feature is off"

# Tagged-api writes do not go through plan mode, so ordered_apply needs them
# refused, and they cannot be allowed again while it is on.
tunable_value() { master_sql "select value from comdb2_tunables where name='$1'"; }
set_tunable disable_tagged_api_writes 0
set_tunable ordered_apply 1 || true
[ "$(tunable_value ordered_apply)" = "OFF" ] || fail "ordered_apply turned on while tagged writes are allowed"
set_tunable disable_tagged_api_writes 1
set_tunable ordered_apply 1
[ "$(tunable_value ordered_apply)" = "ON" ] || fail "ordered_apply did not turn on"
set_tunable disable_tagged_api_writes 0 || true
[ "$(tunable_value disable_tagged_api_writes)" = "ON" ] \
    || fail "tagged writes were allowed again while ordered_apply is on"
set_tunable ordered_apply 0

################################################################
# 2. On: inserts into a table with no unique key are planned, and
#    the rows and their index entries are all there.
################################################################
set_tunable ordered_apply 1
sql "insert into t select value, value * 7, value * 13, 'on' from generate_series(2, 1001)" >/dev/null
[ "$(counter txns)" = "1" ] || fail "the insert was not planned"
[ "$(counter ops)" = "3000" ] || fail "expected 3000 planned btree operations, got $(counter ops)"
[ "$(sql 'select count(*) from t')" = "1001" ] || fail "rows missing from the data file"
[ "$(sql 'select count(*) from t where a >= 0')" = "1001" ] || fail "rows missing from index ta"
[ "$(sql 'select count(*) from t where b >= 0')" = "1001" ] || fail "rows missing from index tb"

# blobs are planned too
sql "insert into bl values(1, x'$(printf 'ab%.0s' $(seq 1 3000))')" >/dev/null
[ "$(sql 'select length(b) from bl where a = 1')" = "3000" ] || fail "blob did not survive a planned insert"

################################################################
# 3. What a plan cannot hold runs as before, with the same results.
################################################################
before=$(counter fallbacks)
sql "insert into u values(1, 1)" >/dev/null
out=$(sql "insert into u values(1, 2)" 2>&1) && fail "duplicate key was accepted"
echo "$out" | grep -qi "duplicate" || fail "duplicate key gave the wrong error: $out"
sql "update t set b = b + 1 where a = 2" >/dev/null
sql "delete from t where a = 3" >/dev/null
sql "insert into p values(1)" >/dev/null
sql "insert into ch values(1)" >/dev/null
out=$(sql "insert into ch values(2)" 2>&1) && fail "foreign key violation was accepted"
[ "$(counter fallbacks)" -gt "$before" ] || fail "nothing fell back"
[ "$(sql 'select b from t where a = 2')" = "15" ] || fail "update was lost"
[ "$(sql 'select count(*) from t where a = 3')" = "0" ] || fail "delete was lost"
[ "$(sql 'select count(*) from u')" = "1" ] || fail "table u is wrong"
[ "$(sql 'select count(*) from ch')" = "1" ] || fail "table ch is wrong"

# one transaction that mixes both kinds; and one that fails and rolls back
cdb2sql --tabs ${CDB2_OPTIONS} $dbname default - >/dev/null <<SQL
begin
insert into t values(5000, 1, 1, 'mixed')
insert into u values(2, 2)
commit
SQL
cdb2sql --tabs ${CDB2_OPTIONS} $dbname default - >/dev/null 2>&1 <<SQL || true
begin
insert into t values(5001, 1, 1, 'rolled back')
insert into u values(2, 3)
commit
SQL
[ "$(sql 'select count(*) from t where a in (5000, 5001)')" = "1" ] || fail "mixed transactions left the wrong rows"
[ "$(sql 'select count(*) from u')" = "2" ] || fail "mixed transactions left the wrong keys"

################################################################
# 4. Many writers on the same pages: no deadlocks, nothing lost.
################################################################
dl_before=$(master_sql "select cast(value as int) from comdb2_metrics where name='deadlocks'")
txns_before=$(counter txns)
base=$(sql 'select count(*) from t')
for w in $(seq 1 8); do
    (
        for i in $(seq 1 100); do
            echo "insert into t select 1000000 + $i * 1000 + value, $w, $i, 'w$w' from generate_series(1, 20)"
        done | cdb2sql ${CDB2_OPTIONS} $dbname default - >/dev/null
    ) &
done
wait
[ "$(sql 'select count(*) from t')" = "$((base + 16000))" ] || fail "concurrent inserts lost rows"
[ "$(sql 'select count(*) from t where b between 1 and 8 and a >= 1000000')" = "16000" ] || fail "index tb is wrong after concurrent inserts"
[ "$(($(counter txns) - txns_before))" = "800" ] || fail "expected 800 planned transactions"
dl_after=$(master_sql "select cast(value as int) from comdb2_metrics where name='deadlocks'")
[ "$dl_after" = "$dl_before" ] || fail "planned inserts deadlocked ($((dl_after - dl_before)) times)"

################################################################
# 5. A btree file per thread, and the next plan starting before the
#    last one commits: same rows, same index entries.
################################################################
set_tunable ordered_apply_parallel_min_ops 1
par_before=$(counter parallel)
base=$(sql 'select count(*) from t')
for mode in 1 0; do
    set_tunable ordered_apply_serial_commit $mode
    for w in $(seq 1 8); do
        (
            for i in $(seq 1 50); do
                echo "insert into t select 2000000 + $mode * 1000000 + $i * 1000 + value, $w, $i, 'p$w' from generate_series(1, 20)"
                echo "insert into bl values($i, randomblob(20000))"
            done | cdb2sql ${CDB2_OPTIONS} $dbname default - >/dev/null
        ) &
    done
    wait
done
[ "$(sql 'select count(*) from t')" = "$((base + 16000))" ] || fail "parallel apply lost rows"
[ "$(sql 'select count(*) from t where a >= 2000000 and a < 4000000')" = "16000" ] || fail "index ta is wrong after parallel apply"
[ "$(sql 'select count(*) from t where b between 1 and 8 and a >= 2000000 and a < 4000000')" = "16000" ] || fail "index tb is wrong after parallel apply"
[ "$(sql 'select count(*) from bl where length(b) = 20000')" = "800" ] || fail "blobs are wrong after parallel apply"
[ "$(($(counter parallel) - par_before))" = "1600" ] || fail "expected 1600 plans applied in parallel, got $(($(counter parallel) - par_before))"
set_tunable ordered_apply_serial_commit 1
set_tunable ordered_apply_parallel_min_ops 64

################################################################
# 5b. Commit units: one thread applies the waiting plans under one
#     transaction.  Same rows, same index entries, same errors, and
#     fewer commits than transactions.
################################################################
set_tunable ordered_apply_unit 1
for minops in 64 1; do
    set_tunable ordered_apply_parallel_min_ops $minops
    units_before=$(counter units)
    txns_before=$(counter txns)
    base=$(sql 'select count(*) from t')
    blbase=$(sql 'select count(*) from bl')
    for w in $(seq 1 16); do
        (
            for i in $(seq 1 100); do
                echo "insert into t values(5000000 + $minops * 1000000 + $i * 100 + $w, $w, $i, 'u$w')"
            done
            echo "insert into t select 7000000 + $minops * 1000000 + $w * 1000 + value, $w, 0, 'm$w' from generate_series(1, 200)"
            echo "insert into bl values(1000 + $w, randomblob(20000))"
        ) | cdb2sql ${CDB2_OPTIONS} $dbname default - >/dev/null &
    done
    wait
    [ "$(sql 'select count(*) from t')" = "$((base + 4800))" ] || fail "commit units lost rows (min ops $minops)"
    [ "$(sql "select count(*) from t where a >= 5000000 + $minops * 1000000 and a < 6000000 + $minops * 1000000")" = "1600" ] || fail "index ta is wrong after commit units"
    [ "$(sql "select count(*) from t where b between 1 and 16 and a >= 7000000 + $minops * 1000000 and a < 8000000 + $minops * 1000000")" = "3200" ] || fail "index tb is wrong after commit units"
    [ "$(sql 'select count(*) from bl')" = "$((blbase + 16))" ] || fail "blobs are wrong after commit units"
    txns=$(($(counter txns) - txns_before))
    units=$(($(counter units) - units_before))
    [ "$txns" = "1632" ] || fail "expected 1632 planned transactions in units, got $txns"
    [ "$units" -gt 0 ] && [ "$units" -lt "$txns" ] || fail "expected fewer units than transactions, got $units for $txns"
done
set_tunable ordered_apply_parallel_min_ops 64

# what a plan cannot hold still runs as before, alone or mixed in a transaction
sql "insert into u values(10, 1)" >/dev/null
out=$(sql "insert into u values(10, 2)" 2>&1) && fail "duplicate key was accepted with commit units"
cdb2sql --tabs ${CDB2_OPTIONS} $dbname default - >/dev/null 2>&1 <<SQL || true
begin
insert into t values(9500001, 1, 1, 'rolled back')
insert into u values(10, 3)
commit
SQL
cdb2sql --tabs ${CDB2_OPTIONS} $dbname default - >/dev/null <<SQL
begin
insert into t values(9500002, 1, 1, 'two inserts')
insert into t values(9500003, 1, 1, 'two inserts')
commit
SQL
[ "$(sql 'select count(*) from t where a between 9500001 and 9500003')" = "2" ] || fail "transactions left the wrong rows with commit units"
[ "$(sql 'select count(*) from u where a = 10')" = "1" ] || fail "table u is wrong with commit units"
[ "$(counter unit_retries)" = "0" ] || echo "note: $(counter unit_retries) units were retried"
set_tunable ordered_apply_unit 0

################################################################
# 5c. Unique keys.  An insert into a table with a unique key is
#     planned; a duplicate is refused with the same error, whether
#     the key was there, is added twice by one transaction, or is
#     being added by another client at the same time.  NULLs do not
#     collide.  With the turn and with commit units.
################################################################
sql "create table pk(a int primary key, b int, c int)" >/dev/null
sql "create index pkb on pk(b)" >/dev/null
sql "create table un(a int unique, b int)" >/dev/null
for unit in 0 1; do
    set_tunable ordered_apply_unit $unit
    base=$((unit * 1000000))
    before=$(counter txns)
    fb_before=$(counter fallbacks)
    sql "insert into pk values($base + 1, 1, 1)" >/dev/null
    [ "$(($(counter txns) - before))" = "1" ] || fail "an insert with a unique key was not planned (unit $unit)"
    out=$(sql "insert into pk values($base + 1, 2, 2)" 2>&1) && fail "duplicate of an existing key was accepted (unit $unit)"
    echo "$out" | grep -qi "duplicate" || fail "duplicate of an existing key gave the wrong error: $out"
    out=$(sql "insert into pk values($base + 2, 1, 1), ($base + 3, 1, 1), ($base + 2, 9, 9)" 2>&1) && fail "a key added twice in one statement was accepted (unit $unit)"
    echo "$out" | grep -qi "duplicate" || fail "a key added twice gave the wrong error: $out"
    out=$(cdb2sql --tabs ${CDB2_OPTIONS} $dbname default - 2>&1 <<SQL
begin
insert into pk values($base + 4, 1, 1)
insert into pk values($base + 4, 2, 2)
commit
SQL
) && fail "a key added twice in one transaction was accepted (unit $unit)"
    echo "$out" | grep -qi "duplicate" || fail "a key added twice in one transaction gave the wrong error: $out"
    [ "$(sql "select count(*) from pk where a between $base + 1 and $base + 9")" = "1" ] || fail "failed inserts left rows behind (unit $unit)"
    sql "insert into un values(null, $unit), (null, $unit)" >/dev/null || fail "two NULLs in a unique key were refused (unit $unit)"
    [ "$(($(counter fallbacks) - fb_before))" = "0" ] || fail "unique-key inserts fell back to page locks (unit $unit)"

    # 16 clients insert the same 300 keys: each key goes in once, and every
    # other attempt is told it is a duplicate
    for w in $(seq 1 16); do
        (
            for i in $(seq 1 300); do
                echo "insert into pk values($base + 1000 + $i, $w, $i)"
            done | cdb2sql ${CDB2_OPTIONS} $dbname default - > ${TMPDIR:-/tmp}/oa_pk_$w.out 2>&1
        ) &
    done
    wait
    [ "$(sql "select count(*) from pk where a > $base + 1000 and a <= $base + 1300")" = "300" ] || fail "concurrent inserts of the same keys left the wrong number of rows (unit $unit)"
    [ "$(sql "select count(*) from pk where b between 1 and 16 and a > $base + 1000 and a <= $base + 1300")" = "300" ] || fail "index pkb is wrong after concurrent unique inserts (unit $unit)"
    dups=$(cat ${TMPDIR:-/tmp}/oa_pk_*.out | grep -ci "duplicate" || true)
    others=$(cat ${TMPDIR:-/tmp}/oa_pk_*.out | grep -i "failed" | grep -vci "duplicate" || true)
    [ "$dups" = "4500" ] || fail "expected 4500 duplicate errors, got $dups (unit $unit)"
    [ "$others" = "0" ] || fail "$others inserts failed with something other than a duplicate (unit $unit)"

    # 8 clients, 10 rows a transaction, the same keys: all of a transaction or none
    for w in $(seq 1 8); do
        (
            for i in $(seq 1 100); do
                echo "insert into pk select $base + 500000 + $i * 10 + value, $w, $i from generate_series(0, 9)"
            done | cdb2sql ${CDB2_OPTIONS} $dbname default - >/dev/null 2>&1
        ) &
    done
    wait
    [ "$(sql "select count(*) from pk where a >= $base + 500000 and a < $base + 600000")" = "1000" ] || fail "multi-row unique inserts left the wrong number of rows (unit $unit)"
    [ "$(sql "select count(*) from (select c, count(*) n, count(distinct b) d from pk where a >= $base + 500000 and a < $base + 600000 group by c having n != 10 or d != 1)")" = "0" ] || fail "a multi-row unique insert was applied in part (unit $unit)"
    rm -f ${TMPDIR:-/tmp}/oa_pk_*.out
done
set_tunable ordered_apply_unit 0
master_sql "exec procedure sys.cmd.verify('pk')" | grep -q "Verify succeeded" || fail "verify of pk failed"

# off: a table with a unique key is not planned
set_tunable ordered_apply_unique 0
fb_before=$(counter fallbacks)
sql "insert into pk values(9999999, 1, 1)" >/dev/null
[ "$(($(counter fallbacks) - fb_before))" = "1" ] || fail "ordered_apply_unique off still planned a unique-key insert"
set_tunable ordered_apply_unique 1

################################################################
# 5d. Inserts while a schema change runs.  They take the path that
#     adds keys at the end of the request from the row read back
#     by genid.  A planned row is not in the data file, so that read
#     has to be answered from the plan, or the request has to run
#     without one; either way none may fail.
################################################################
set_tunable ordered_apply_unit 1
sql "create table sc(a int primary key, b int)" >/dev/null
for w in $(seq 1 8); do
    (
        for i in $(seq 1 400); do
            echo "insert into sc values($w * 100000 + $i, $i)"
        done | cdb2sql ${CDB2_OPTIONS} $dbname default - > ${TMPDIR:-/tmp}/oa_sc_$w.out 2>&1
    ) &
done
for i in 1 2 3; do
    sql "rebuild sc" >/dev/null || fail "rebuild failed"
    sql "create index scb$i on sc(b)" >/dev/null || fail "create index failed"
done
wait
scfailed=$(cat ${TMPDIR:-/tmp}/oa_sc_*.out | grep -ci "failed" || true)
[ "$scfailed" = "0" ] || fail "$scfailed inserts failed while a schema change ran: $(cat ${TMPDIR:-/tmp}/oa_sc_*.out | grep -i failed | head -1)"
[ "$(sql 'select count(*) from sc')" = "3200" ] || fail "inserts during a schema change lost rows"
[ "$(sql 'select count(*) from sc where b > 0')" = "3200" ] || fail "an index built during inserts is wrong"
master_sql "exec procedure sys.cmd.verify('sc')" | grep -q "Verify succeeded" || fail "verify of sc failed"
rm -f ${TMPDIR:-/tmp}/oa_sc_*.out
set_tunable ordered_apply_unit 0

################################################################
# 5e. Updates and deletes.  The same statements are run on one table
#     under page locks and on others with plans, in turn and in
#     commit units; the clients must be told the same things and the
#     tables must end up the same.  Then many clients change the same
#     rows at once.
################################################################
ud_script() {
    cat <<SQL
insert into ud$1 select value, value % 10, value, 'row' from generate_series(1, 1000)
update ud$1 set pad = 'changed' where a = 5
update ud$1 set b = b + 100 where a <= 100
update ud$1 set c = c + 100000 where a = 7
update ud$1 set c = 8 where a = 9
delete from ud$1 where a between 400 and 499
delete from ud$1 where a = 400
update ud$1 set c = c + 1 where a between 300 and 399
update ud$1 set c = c + 1 where a between 200 and 250
update ud$1 set a = a + 5000 where a between 600 and 650
update ud$1 set pad = 'a much longer value than the row had before, so that it grows where it is or moves' where a between 700 and 720
update ud$1 set pad = 'x' where a between 700 and 710
begin
delete from ud$1 where a = 1
insert into ud$1 values(1, 5, 1, 'again')
commit
begin
update ud$1 set b = 77 where a = 2
update ud$1 set c = 200002 where a = 3
delete from ud$1 where a = 4
insert into ud$1 values(3001, 1, 4, 'takes the key of a deleted row')
insert into ud$1 select 4000 + value, 3, 4000 + value, 'with the rest' from generate_series(1, 50)
commit
begin
insert into ud$1 values(3002, 1, 3002, 'rolled back')
update ud$1 set c = 10 where a = 11
commit
begin
update ud$1 set b = 1 where a = 12
update ud$1 set b = 2 where a = 12
commit
begin
delete from ud$1 where a = 13
update ud$1 set b = 2 where a = 13
commit
delete from ud$1 where a > 900
insert into bu$1 values(1, x'$(printf 'ab%.0s' $(seq 1 3000))', 'one'), (2, null, 'two'), (3, x'$(printf 'cd%.0s' $(seq 1 2000))', 'three'), (4, x'00', 'four')
update bu$1 set b = x'$(printf 'ef%.0s' $(seq 1 5000))' where a = 1
update bu$1 set b = null where a = 3
update bu$1 set c = 'new' where a = 1
update bu$1 set b = x'$(printf '12%.0s' $(seq 1 100))' where a = 2
update bu$1 set a = a + 10, c = 'moved' where a = 4
delete from bu$1 where a = 1
SQL
}
ud_tables() {
    sql "create table ud$1(a int, b int, c int, pad varchar(120))" >/dev/null
    sql "create unique index ud$1_a on ud$1(a)" >/dev/null
    sql "create index ud$1_b on ud$1(b)" >/dev/null
    sql "create unique index ud$1_c on ud$1(c)" >/dev/null
    sql "create table bu$1(a int, b blob, c varchar(8))" >/dev/null
    sql "create unique index bu$1_a on bu$1(a)" >/dev/null
}
ud_state() {
    sql "select a, b, c, pad from ud$1 order by a"
    sql "select count(*) from ud$1 where b >= 0"
    sql "select count(*), sum(c) from ud$1 where c >= 0"
    sql "select a, length(b), c from bu$1 order by a"
    sql "select count(*) from bu$1 where a >= 0"
}
# what the client was told, less the table's name and the genids
ud_norm() {
    local u=$(echo $1 | tr a-z A-Z)
    sed -e "s/ud$1/ud/g; s/bu$1/bu/g; s/UD$u/UD/g; s/BU$u/BU/g; s/genid=[0-9a-f]*/genid=X/"
}
udtmp=${TMPDIR:-/tmp}/oa_ud_$$

set_tunable ordered_apply 0
ud_tables r
ud_script r | cdb2sql ${CDB2_OPTIONS} $dbname default - 2>&1 | ud_norm r > $udtmp.r.out || true
ud_state r > $udtmp.r.state
[ "$(sql 'select count(*) from udr')" -gt 500 ] || fail "the update script did not run"
grep -qi "duplicate" $udtmp.r.out || fail "the update script should hit a duplicate key"
set_tunable ordered_apply 1

for unit in 0 1; do
    set_tunable ordered_apply_unit $unit
    txns_before=$(counter txns)
    fb_before=$(counter fallbacks)
    ud_tables $unit
    ud_script $unit | cdb2sql ${CDB2_OPTIONS} $dbname default - 2>&1 | ud_norm $unit > $udtmp.$unit.out || true
    ud_state $unit > $udtmp.$unit.state
    diff $udtmp.r.out $udtmp.$unit.out >&2 || fail "updates and deletes told the client something else with plans (unit $unit)"
    diff $udtmp.r.state $udtmp.$unit.state >&2 || fail "updates and deletes left a different table with plans (unit $unit)"
    [ "$(($(counter txns) - txns_before))" -ge 15 ] || fail "updates and deletes were not planned (unit $unit): $(($(counter txns) - txns_before)) plans"
    echo "updates and deletes, unit $unit: $(($(counter txns) - txns_before)) planned, $(($(counter fallbacks) - fb_before)) fell back"
    master_sql "exec procedure sys.cmd.verify('ud$unit')" | grep -q "Verify succeeded" || fail "verify of ud$unit failed"
    master_sql "exec procedure sys.cmd.verify('bu$unit')" | grep -q "Verify succeeded" || fail "verify of bu$unit failed"
done

# off: updates and deletes are not planned
set_tunable ordered_apply_update 0
fb_before=$(counter fallbacks)
sql "update ud1 set b = b + 1 where a = 20" >/dev/null
sql "delete from ud1 where a = 21" >/dev/null
[ "$(($(counter fallbacks) - fb_before))" = "2" ] || fail "ordered_apply_update off still planned an update or a delete"
set_tunable ordered_apply_update 1

# Many clients, the same rows.  Every update that the client is told
# succeeded is in the table once; every row is deleted by exactly one client.
sql "create table hot(a int primary key, b int, c int)" >/dev/null
sql "create index hotc on hot(c)" >/dev/null
for mode in turn unit unitpar; do
    case $mode in
    turn) set_tunable ordered_apply_unit 0; set_tunable ordered_apply_parallel_min_ops 64 ;;
    unit) set_tunable ordered_apply_unit 1; set_tunable ordered_apply_parallel_min_ops 64 ;;
    unitpar) set_tunable ordered_apply_unit 1; set_tunable ordered_apply_parallel_min_ops 1 ;;
    esac
    sql "delete from hot where 1" >/dev/null
    sql "insert into hot select value, 0, 0 from generate_series(1, 400)" >/dev/null
    stale_before=$(counter stale_retries)
    locked_before=$(counter read_locked)
    for w in $(seq 1 16); do
        (
            for i in $(seq 1 150); do
                echo "update hot set b = b + 1, c = c + 1 where a = $(( (i * 7 + w) % 20 + 1 ))"
                echo "update hot set b = b + 1 where a between $(( 100 + (i + w) % 50 )) and $(( 104 + (i + w) % 50 ))"
            done | cdb2sql ${CDB2_OPTIONS} $dbname default - > $udtmp.hot.$w.out 2>&1
        ) &
    done
    wait
    one=$(cat $udtmp.hot.*.out | grep -c "rows updated=1)" || true)
    five=$(cat $udtmp.hot.*.out | grep -c "rows updated=5)" || true)
    bad=$(cat $udtmp.hot.*.out | grep -v "rows updated=[15])" | grep -v "\] rc 0\$" | grep -vci "failed" || true)
    failed=$(cat $udtmp.hot.*.out | grep -ci "failed" || true)
    [ "$bad" = "0" ] || fail "updates of the same rows reported something unexpected ($mode): $(cat $udtmp.hot.*.out | grep -v 'rows updated=[15])' | grep -v '\] rc 0$' | grep -vi failed | head -1)"
    [ "$((one + five + failed))" = "4800" ] || fail "expected 4800 answers, got $((one + five + failed)) ($mode)"
    [ "$(sql 'select sum(b) from hot')" = "$((one + five * 5))" ] || fail "updates of the same rows were lost or applied twice ($mode): sum $(sql 'select sum(b) from hot'), told $((one + five * 5))"
    [ "$(sql 'select sum(c) from hot where c >= 0')" = "$one" ] || fail "index hotc is wrong after updates of the same rows ($mode)"
    echo "hot rows, $mode: $one + $five updates, $failed failed, $(($(counter stale_retries) - stale_before)) stale plans, $(($(counter read_locked) - locked_before)) reads gave up"

    for w in $(seq 1 8); do
        (
            for i in $(seq 1 400); do
                echo "delete from hot where a = $i"
            done | cdb2sql ${CDB2_OPTIONS} $dbname default - > $udtmp.hot.$w.out 2>&1
        ) &
    done
    wait
    deleted=$(cat $udtmp.hot.*.out | grep -c "rows deleted=1)" || true)
    failed=$(cat $udtmp.hot.*.out | grep -ci "failed" || true)
    [ "$deleted" = "400" ] || fail "expected each of 400 rows to be deleted once, got $deleted ($mode, $failed failed)"
    [ "$(sql 'select count(*) from hot')" = "0" ] || fail "rows left after concurrent deletes ($mode)"
    [ "$(sql 'select count(*) from hot where c >= 0')" = "0" ] || fail "index entries left after concurrent deletes ($mode)"
    master_sql "exec procedure sys.cmd.verify('hot')" | grep -q "Verify succeeded" || fail "verify of hot failed ($mode)"
done

# Many clients race to move one row's unique key on by one.  One wins each
# step.  The others find the row changed, which the client library retries
# and which ends with no row to update; none may be told the key is a
# duplicate, though the winner's new key is in the index by the time a loser
# gets to adding its own.
sql "create table seq(name varchar(8), seed int)" >/dev/null
sql "create unique index seq_k on seq(name, seed)" >/dev/null
for unit in 0 1; do
    set_tunable ordered_apply_unit $unit
    sql "delete from seq where 1" >/dev/null
    sql "insert into seq values('x', 0)" >/dev/null
    fb_before=$(counter fallbacks)
    for w in $(seq 1 16); do
        (
            for i in $(seq 0 149); do
                echo "update seq set seed = $((i + 1)) where name = 'x' and seed = $i"
            done | cdb2sql ${CDB2_OPTIONS} $dbname default - > $udtmp.seq.$w.out 2>&1
        ) &
    done
    wait
    failed=$(cat $udtmp.seq.*.out | grep -ci "failed" || true)
    won=$(cat $udtmp.seq.*.out | grep -c "rows updated=1)" || true)
    [ "$failed" = "0" ] || fail "$failed racing updates of a unique key failed (unit $unit): $(cat $udtmp.seq.*.out | grep -i failed | head -1)"
    [ "$(sql 'select seed from seq')" = "150" ] || fail "racing updates of a unique key ended at $(sql 'select seed from seq') (unit $unit)"
    [ "$won" = "150" ] || fail "expected 150 winning updates of a unique key, got $won (unit $unit)"
    echo "racing updates of a unique key, unit $unit: $(($(counter fallbacks) - fb_before)) requests ran again without a plan"
done
set_tunable ordered_apply_unit 0
set_tunable ordered_apply_parallel_min_ops 64

# SELECTV.  The rows it reads must stay as they are until the transaction
# commits, which a plan's reads do not see to: such a transaction runs without
# a plan.  And it takes the commit lock for itself, so it must not find that
# lock left behind by a request whose plan could not be applied, of which the
# updates of the same rows above made many.
fb_before=$(counter fallbacks)
cdb2sql --tabs ${CDB2_OPTIONS} $dbname default - > $udtmp.selectv.out 2>&1 <<SQL &
begin
selectv a from ud0 where a = 30
update ud0 set b = 99 where a = 30
commit
SQL
svpid=$!
for i in $(seq 1 60); do
    kill -0 $svpid 2>/dev/null || break
    sleep 1
done
if kill -0 $svpid 2>/dev/null; then
    kill $svpid
    fail "a SELECTV transaction did not finish in a minute"
fi
wait $svpid || fail "a SELECTV transaction failed: $(cat $udtmp.selectv.out)"
[ "$(sql 'select b from ud0 where a = 30')" = "99" ] || fail "a SELECTV transaction's update was lost"
[ "$(($(counter fallbacks) - fb_before))" -ge 1 ] || fail "a SELECTV transaction was planned"
rm -f $udtmp.*

################################################################
# 6. Every node has the same table, and it verifies.
################################################################
want=$(master_sql "select count(*), sum(a), sum(b), sum(c) from t")
for node in ${CLUSTER:-$master}; do
    for i in $(seq 1 30); do
        got=$(cdb2sql --tabs ${CDB2_OPTIONS} $dbname --host $node "select count(*), sum(a), sum(b), sum(c) from t")
        [ "$got" = "$want" ] && break
        sleep 1
    done
    [ "$got" = "$want" ] || fail "$node has a different table t: $got, master has $want"
done
master_sql "exec procedure sys.cmd.verify('t')" | grep -q "Verify succeeded" || fail "verify failed"

################################################################
# 7. Off again: back to page locks held to commit.
################################################################
set_tunable ordered_apply 0
before=$(counter txns)
sql "insert into t values(9000, 1, 1, 'off again')" >/dev/null
[ "$(counter txns)" = "$before" ] || fail "still planning after being turned off"

echo "Testcase passed."
